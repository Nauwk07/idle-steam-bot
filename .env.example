DISCORD_TOKEN=
DISCORD_OWNER_ID=
DISCORD_GUILD_ID=

# URL de connexion Supabase (Transaction mode si PgBouncer, sinon Session mode)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Clé de chiffrement AES-256 (64 caractères hex = 32 bytes)
# Génère avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

LOG_LEVEL=info
DRY_RUN=false
STEAM_PLAY_SCAN_INTERVAL_SECONDS=300

PUID=1000
PGID=1000
