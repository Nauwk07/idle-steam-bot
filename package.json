{
  "name": "idle-steam",
  "version": "1.0.0",
  "description": "Bot Discord personnel pour piloter un idle Steam.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch src/index.ts",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning node dist/index.js",
    "docker:prod": "docker compose up -d --build",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "docker:logs": "docker compose logs -f",
    "docker:down": "docker compose down",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@types/pg": "^8.20.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "steam-user": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/steam-user": "^5.1.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "protobufjs": "^7.5.5"
  }
}
